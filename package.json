{
  "name": "opencode-ember",
  "version": "1.0.0",
  "description": "OpenCode prompt-cache cost guard: estimates cold cache-rewrite costs, warns or blocks before expensive sends, and reports recorded costs across sessions.",
  "type": "module",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-ember.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-ember#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-ember/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt-cache",
    "prompt-caching",
    "cache",
    "anthropic",
    "llm",
    "cost",
    "tokens",
    "cost-estimation",
    "token-cost"
  ],
  "main": "ember.ts",
  "exports": {
    ".": "./ember.ts",
    "./tui": "./src/tui.ts"
  },
  "bin": {
    "ember": "gain.ts"
  },
  "files": [
    "ember.ts",
    "src",
    "gain.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "opencode": ">=1.18.29 <2 || >=2.1.4 <3"
  },
  "scripts": {
    "prepare": "husky",
    "test": "bun test && bash tests/changelog.sh",
    "test:unit": "bun test",
    "test:changelog": "bash tests/changelog.sh",
    "typecheck": "tsc --noEmit",
    "lint:sh": "for script in install.sh tests/*.sh scripts/*.sh; do bash -n \"$script\" || exit; done",
    "gain": "bun gain.ts",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": { "optional": true },
    "@opencode/plugin": { "optional": true }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opencode-ai/plugin": "1.19.3",
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "26.6.5",
    "husky": "^9.1.7",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  }
}
