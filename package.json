{
  "name": "opencode-ember",
  "version": "0.1.0",
  "description": "Keep an LLM prompt cache warm across breaks, guard cold rewrites before you pay for them, and score what a break actually cost. An opencode plugin.",
  "type": "module",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-ember.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-ember#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-ember/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt-cache",
    "prompt-caching",
    "cache",
    "anthropic",
    "llm",
    "cost",
    "tokens"
  ],
  "main": "ember.ts",
  "exports": {
    ".": "./ember.ts"
  },
  "bin": {
    "ember": "gain.ts"
  },
  "files": [
    "ember.ts",
    "gain.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "test": "bun test && bash tests/changelog.sh",
    "test:unit": "bun test",
    "test:changelog": "bash tests/changelog.sh",
    "typecheck": "tsc --noEmit",
    "lint:sh": "for script in install.sh tests/*.sh scripts/*.sh; do bash -n \"$script\" || exit; done",
    "gain": "bun gain.ts",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opencode-ai/plugin": "1.18.31",
    "@types/node": "24.13.5",
    "husky": "^9.1.7",
    "typescript": "5.9.3"
  }
}
